# ==============================================================================
# Service Desk "Линия" - Production Environment Configuration
# ==============================================================================

# Public URL of the service (used for bot webhooks and links)
APP_PUBLIC_URL=https://desk.example.com

# Cookie Security (set to 1 for HTTPS deployments)
APP_SECURE_COOKIE=1

# SQLite Database Location (must be absolute path for production)
APP_DB=/srv/service-desk/data/app.db

# Brute-force rate limiting (maximum login/registration attempts per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# Initial Admin Bootstrap (used with: python app.py bootstrap-admin)
ADMIN_NAME=Администратор
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeNow123!

# ==============================================================================
# Messenger Integrations (Optional)
# ==============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_URL=https://t.me/your_bot

MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_BOT_URL=https://max.ru/your_bot

# Optional trusted CA bundle for outbound HTTPS requests
BOT_CA_BUNDLE=

# ==============================================================================
# Features & Web Push
# ==============================================================================
# Раздел биллинга (счета, акты, депозит часов). Пока не готов — выключен (0).
BILLING_ENABLED=0

# Ставка, которую показывает калькулятор на лендинге, ₽ за час
DEFAULT_HOURLY_RATE_RUB=3000

# Push-уведомления. Без ключа он создаётся сам и хранится рядом с базой (vapid_private.pem).
# Приватный ключ P-256 в base64url (32 байта); subject — mailto: с рабочим адресом.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
