# ==============================================================================
# Service Desk "Линия" - Production Environment Configuration
# ==============================================================================

# Public URL of the service (used for bot webhooks and links)
APP_PUBLIC_URL=https://desk.example.com

# Cookie Security (set to 1 for HTTPS deployments)
APP_SECURE_COOKIE=1

# SQLite Database Location (must be absolute path for production)
APP_DB=/srv/service-desk/data/app.db

# Brute-force rate limiting (maximum login/registration attempts per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# Initial Admin Bootstrap (used with: python app.py bootstrap-admin)
ADMIN_NAME=Администратор
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeNow123!

# ==============================================================================
# Messenger Integrations (Optional)
# ==============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_URL=https://t.me/your_bot

MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_BOT_URL=https://max.ru/your_bot

# Optional trusted CA bundle for outbound HTTPS requests
BOT_CA_BUNDLE=

# ==============================================================================
# Features & Web Push
# ==============================================================================
# Раздел биллинга (счета, акты, депозит часов). Пока не готов — выключен (0).
BILLING_ENABLED=0

# Ставка, которую показывает калькулятор на лендинге, ₽ за час
DEFAULT_HOURLY_RATE_RUB=3000

# Push-уведомления. Без ключа он создаётся сам и хранится рядом с базой (vapid_private.pem).
# Приватный ключ P-256 в base64url (32 байта); subject — mailto: с рабочим адресом.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ==============================================================================
# Работа с клиентом: напоминания, почта, ежемесячная сводка
# ==============================================================================
# Часовой пояс команды относительно UTC: по нему считаются рабочие часы напоминаний и дата сводки
APP_UTC_OFFSET=3

# Напоминания клиенту о его шагах (оценка, доп. часы, приёмка, ответ на вопрос).
# Первое — через REMINDER_FIRST_HOURS, затем не чаще REMINDER_REPEAT_HOURS, всего REMINDER_MAX.
# После последнего ответственный получает подсказку «заказчик молчит». REMINDER_MAX=0 выключает.
REMINDER_FIRST_HOURS=48
REMINDER_REPEAT_HOURS=72
REMINDER_MAX=3
REMINDER_HOURS=9-20

# Отправка писем. Без SMTP_HOST почта выключена. EMAIL_BACKEND=file пишет письма в .eml для проверки.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Линия <noreply@example.com>
# Письмо уходит, только если событие не прочитано в кабинете за это время
EMAIL_DELAY_SECONDS=120

# Ответы на письма попадают в переписку. Ящик для ответов читается по IMAP
# или принимается вебхуком POST /api/email/inbound с заголовком X-Inbound-Secret.
EMAIL_REPLY_TO=support@example.com
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
EMAIL_INBOUND_SECRET=

# Ежемесячная сводка клиентам за прошлый месяц уходит в этот день месяца после 9:00
DIGEST_DAY=1

# Фоновые задачи (почта, напоминания, сводка) работают внутри веб-процесса; 0 — выключить
BACKGROUND_JOBS=1
